---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Derecho del Consumidor | M-GEO Abogados">
  
  <section class="relative bg-brand-dark text-white pt-36 pb-24 px-6 overflow-hidden z-10">
    <div class="absolute inset-0 z-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] pointer-events-none"></div>
    
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[40rem] h-[40rem] bg-brand-primary/30 rounded-full blur-[130px] pointer-events-none z-0"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 bg-white/5 rounded-full blur-[90px] pointer-events-none z-0"></div>

    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-px bg-gradient-to-r from-transparent via-white/15 to-transparent z-10"></div>

    <div class="container mx-auto max-w-6xl relative z-20">
      
      <a href="/estudio#especialidades" class="inline-flex items-center gap-3 text-gray-400 hover:text-brand-primary font-body text-[10px] uppercase tracking-[0.3em] transition-all duration-300 mb-12 group">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform duration-300"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
        Volver a Especialidades
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-8">
          <h1 class="text-5xl md:text-7xl lg:text-7xl font-heading font-bold tracking-tight leading-[1.05] mb-6">
            <span class="text-brand-primary">Derecho del</span> <br/>
            <span class="text-white italic">Consumidor.</span>
          </h1>
        </div>

        <div class="lg:col-span-4 lg:pb-3 border-l border-white/10 pl-6 lg:pl-8">
          <p class="text-base md:text-lg font-light text-gray-300 leading-relaxed font-heading italic">
            "Representamos a consumidores y/o usuarios y/o Empresas en reclamos de Defensa del Consumidor, buscando soluciones rápidas y efectivas."
          </p>
        </div>
      </div>

    </div>
  </section>

  <section class="py-20 md:py-32 bg-[#F9F8F6] px-6 relative z-20">
    <div class="container mx-auto max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
        
        <div class="lg:col-span-6 space-y-10">
          
          <div class="border-l-2 border-brand-primary pl-6 md:pl-8 py-2">
            <span class="text-brand-primary font-body font-bold tracking-[0.2em] uppercase text-[10px] block mb-2">Enfoque Estratégico</span>
            <h2 class="text-2xl md:text-3xl font-heading font-bold text-brand-dark tracking-tight leading-snug">
              Representación efectiva en conflictos.
            </h2>
          </div>
          
          <div class="space-y-6 text-gray-600 font-light text-base md:text-lg leading-relaxed pl-2">
            <p class="text-gray-700 font-normal">
              Intervenimos en reclamos por incumplimientos contractuales, problemas con servicios, compras online y conflictos con compañías de seguros, bancos y empresas de distintos rubros.
            </p>

            <p>
              En una primera instancia priorizamos la vía extrajudicial promoviendo acuerdos favorables y, de ser necesario la representación judicial.
            </p>
          </div>

          <div class="pt-8 border-t border-gray-200/60 flex items-center gap-4 pl-2">
            <div class="w-10 h-10 rounded-full bg-brand-dark flex items-center justify-center text-white font-bold text-xs shrink-0 shadow-md">
              MG
            </div>
            <div>
              <p class="text-xs font-bold text-brand-dark uppercase tracking-wider font-body">Estructura Integral</p>
              <p class="text-xs text-gray-400 font-light">Gestión extrajudicial y judicial permanente.</p>
            </div>
          </div>

        </div>

        <div class="lg:col-span-6 lg:sticky lg:top-32">
          <div class="bg-brand-dark text-white border border-white/10 shadow-2xl p-8 md:p-12 rounded-sm relative overflow-hidden group">
            
            <div class="absolute inset-0 z-0 opacity-[0.05] bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] pointer-events-none"></div>
            <div class="absolute -top-20 -right-20 w-60 h-60 bg-brand-primary/30 rounded-full blur-[70px] pointer-events-none z-0"></div>

            <div class="relative z-10 mb-8 border-b border-white/10 pb-6">
              <span class="text-brand-primary font-bold text-[10px] uppercase tracking-widest mb-2 block">Checklist de inicio</span>
              <h3 class="text-2xl md:text-3xl font-heading font-bold text-white">Documentación necesaria</h3>
              <p class="text-gray-400 text-xs md:text-sm font-light mt-2 leading-relaxed">
                Para evaluar el reclamo, sugerimos contar con:
              </p>
            </div>

            <ul class="relative z-10 space-y-5">
              <li class="flex items-start gap-4">
                <div class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-gray-200 text-xs md:text-sm font-light leading-snug">DNI</span>
              </li>
              
              <li class="flex items-start gap-4">
                <div class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-gray-200 text-xs md:text-sm font-light leading-snug">Factura, ticket o comprobante de compra</span>
              </li>

              <li class="flex items-start gap-4">
                <div class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-gray-200 text-xs md:text-sm font-light leading-snug">Contrato o documentación vinculada al servicio</span>
              </li>

              <li class="flex items-start gap-4">
                <div class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-gray-200 text-xs md:text-sm font-light leading-snug">Capturas de pantalla, correos o mensajes intercambiados</span>
              </li>

              <li class="flex items-start gap-4">
                <div class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-gray-200 text-xs md:text-sm font-light leading-snug">Reclamos realizados previamente</span>
              </li>

              <li class="flex items-start gap-4">
                <div class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-gray-200 text-xs md:text-sm font-light leading-snug">Presupuestos, informes o constancias relacionadas al problema</span>
              </li>

              <li class="flex items-start gap-4">
                <div class="w-5 h-5 rounded-full bg-brand-primary/20 border border-brand-primary flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-gray-200 text-xs md:text-sm font-light leading-snug">Cualquier otra documentación útil para acreditar el incumplimiento</span>
              </li>
            </ul>

            <div class="relative z-10 mt-10 pt-8 border-t border-white/10 flex flex-col items-center">
              <a href="https://wa.me/541139083310" target="_blank" rel="noopener noreferrer" class="w-full bg-brand-primary text-white py-4 font-body font-bold uppercase tracking-[0.2em] text-[11px] hover:bg-white hover:text-brand-dark transition-all duration-500 shadow-xl text-center block">
                Iniciar Consulta Legal
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Botón de WhatsApp Flotante (Solo para Estudio Jurídico) -->
  <a 
    href="https://wa.me/541139083310" 
    target="_blank" 
    rel="noopener noreferrer" 
    class="fixed bottom-8 right-8 z-50 bg-[#25D366] text-white p-4 rounded-full shadow-[0_4px_20px_0_rgba(37,211,102,0.4)] hover:scale-110 hover:shadow-[0_6px_25px_rgba(37,211,102,0.3)] transition-all duration-300 flex items-center justify-center group"
    aria-label="Contactar por WhatsApp"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" viewBox="0 0 16 16" class="transform group-hover:-translate-y-0.5 transition-transform duration-300">
      <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
    </svg>
  </a>

</Layout>