---
import Layout from '../layouts/Layout.astro';
---

<Layout title="M-GEO | Matías Georgetta - Excelencia Legal y Gestión Deportiva">
  
  <section class="relative h-screen flex items-center justify-center overflow-hidden bg-brand-dark">
    <div class="absolute inset-0 z-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]"></div>
    <div class="absolute inset-0 z-0 bg-gradient-to-b from-brand-dark via-transparent to-brand-dark"></div>
    
    <div class="absolute -top-[10%] -left-[10%] w-[40rem] h-[40rem] bg-brand-primary/10 rounded-full blur-[120px] pointer-events-none animate-pulse"></div>
    <div class="absolute -bottom-[10%] -right-[10%] w-[40rem] h-[40rem] bg-brand-primary/15 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container mx-auto max-w-5xl relative z-10 text-center px-6">
      <div class="mb-10 inline-flex items-center gap-3 bg-white/5 border border-white/10 rounded-full px-6 py-2 backdrop-blur-md">
        <!-- <span class="w-1.5 h-1.5 rounded-full bg-brand-primary"></span> -->
        <span class="text-gray-300 font-body text-[10px] tracking-[0.4em] uppercase font-bold">Arquitectura de Resultados</span>
      </div>

      <h1 class="text-7xl md:text-9xl lg:text-[11rem] font-heading font-bold leading-none mb-10 tracking-tighter text-white">
        M-GEO<span class="text-brand-primary">.</span>
      </h1>

      <p class="text-xl md:text-3xl font-heading italic font-light text-gray-400 max-w-4xl mx-auto leading-tight mb-12">
        Asesoramiento jurídico integral y representación de futbolistas mediante <span class="text-white">estructuras independientes</span> e <span class="text-white">interrelacionadas</span>.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-8 pt-6">
        <a href="#unidades" class="group flex items-center gap-4 text-white font-body font-semibold text-[11px] uppercase tracking-[0.3em] transition-all">
          Explorar Unidades
          <div class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-brand-primary group-hover:border-brand-primary transition-all duration-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="py-24 md:py-32 bg-white px-6">
    <div class="container mx-auto max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
        
        <div class="lg:col-span-5 lg:sticky lg:top-32">
          <div class="relative group">
            <div class="aspect-[4/5] overflow-hidden rounded-sm relative z-10 shadow-2xl grayscale hover:grayscale-0 transition-all duration-[1.5s] ease-out">
              <img src="/matias-geo.png" alt="Matías Georgetta" class="w-full h-full object-cover object-top" />
            </div>
            <div class="absolute -top-10 -left-10 w-40 h-40 bg-brand-light -z-0 opacity-50"></div>
            <div class="absolute -bottom-6 -right-6 w-full h-full border border-brand-dark/5 -z-10"></div>
          </div>
        </div>

        <div class="lg:col-span-7 lg:pl-12">
          <div class="inline-flex items-center gap-4 mb-8">
            <div class="w-10 h-px bg-brand-primary"></div>
            <span class="text-brand-primary font-body font-bold tracking-[0.3em] uppercase text-[10px] md:text-xs">Liderazgo Estratégico</span>
          </div>
          
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-brand-dark mb-8 tracking-tight leading-[1.1]">
            Matías Georgetta<br/>
            <span class="text-gray-400 font-light italic">Fundador & Director.</span>
          </h2>

          
          <div class="space-y-8 text-gray-600 font-light text-base md:text-lg leading-relaxed max-w-2xl">
            <p>
              M-GEO nace a partir del desarrollo de un <span class="text-brand-dark font-medium">estudio jurídico</span> orientado al asesoramiento integral y estratégico. Con el tiempo, esa visión profesional se expandió hacia la <span class="text-brand-dark font-medium">representación de futbolistas</span>, dando origen a una estructura independiente enfocada en la gestión y proyección deportiva.
            </p>
            
            <div class="flex items-center gap-6 mb-8 pb-2">
              <a href="https://www.linkedin.com/in/matiasgeorgetta/" target="_blank" class="flex items-center gap-2 text-xs font-body font-bold uppercase tracking-wider text-gray-400 hover:text-brand-dark transition-colors duration-300 group">
                <svg class="w-4 h-4 text-gray-400 group-hover:text-brand-dark transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
                <!-- <span>LinkedIn</span> -->
              </a>
  
              <a href="https://www.instagram.com/matias.georgetta/" target="_blank" class="flex items-center gap-2 text-xs font-body font-bold uppercase tracking-wider text-gray-400 hover:text-brand-primary transition-colors duration-300 group">
                <svg class="w-4 h-4 text-gray-400 group-hover:text-brand-primary transition-colors" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.5" y2="6.5"></line>
                </svg>
                <!-- <span>Instagram</span> -->
              </a>
            </div>

            <div class="pt-10 border-t border-gray-100 flex flex-col sm:flex-row items-start sm:items-center gap-10">
              <div class="flex-1">
                <p class="text-[10px] uppercase tracking-widest text-brand-primary font-bold mb-2">Enfoque Jurídico</p>
                <p class="text-sm text-gray-500 leading-relaxed">Estructura, confianza, criterio y visión profesional para abordar cada caso.</p>
              </div>
              <div class="hidden sm:block w-px h-12 bg-gray-100"></div>
              <div class="flex-1">
                <p class="text-[10px] uppercase tracking-widest text-brand-primary font-bold mb-2">Proyección Deportiva</p>
                <p class="text-sm text-gray-500 leading-relaxed">Crecimiento profesional, desarrollo y respaldo estratégico para futbolistas.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section id="unidades" class="py-24 md:py-32 relative overflow-hidden bg-brand-dark px-6">
    <div class="absolute inset-0 z-0 opacity-5 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] pointer-events-none"></div>
    
    <div class="absolute top-[28%] md:top-1/2 left-1/2 md:left-[30%] -translate-x-1/2 -translate-y-1/2 w-[30rem] h-[30rem] md:w-[45rem] md:h-[45rem] bg-brand-primary/15 rounded-full blur-[120px] pointer-events-none z-0"></div>
    
    <div class="absolute top-[78%] md:top-1/2 left-1/2 md:left-[70%] -translate-x-1/2 -translate-y-1/2 w-[30rem] h-[30rem] md:w-[45rem] md:h-[45rem] bg-brand-primary/10 rounded-full blur-[120px] pointer-events-none z-0"></div>

    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-px bg-gradient-to-r from-transparent via-white/5 to-transparent z-10"></div>

    <div class="container mx-auto max-w-6xl px-4 sm:px-6 relative z-10">
      
      <div class="text-center mb-16 md:mb-24">
        <span class="text-brand-primary font-body font-bold tracking-[0.3em] uppercase text-[10px] md:text-xs mb-4 block">Elige tu camino</span>
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6 tracking-tight leading-[1.1]">Unidades Operativas</h2>
        <div class="w-12 h-[1px] bg-brand-primary/50 mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-20 md:gap-12 pt-4">
        
        <div class="flex flex-col items-center text-center group">
          
          <a href="/estudio" class="w-56 h-56 md:w-64 md:h-64 mb-8 drop-shadow-[0_10px_20px_rgba(0,0,0,0.4)] transition-all duration-700 group-hover:scale-105 flex items-center justify-center block">
            <img src="/logo-abogados.png" alt="MGEO Abogados" class="w-48 h-48 md:w-56 md:h-56 object-contain" />
          </a>
          
          <p class="text-gray-300 text-sm md:text-base font-light max-w-xs md:max-w-sm mx-auto leading-relaxed mb-8">
            Asesoramiento Legal de empresas y particulares en Derecho Laboral, Civil, Comercial y Deportivo.
          </p>
          
          <a href="/estudio" class="inline-flex items-center gap-3 text-white font-body text-[10px] md:text-[11px] font-bold uppercase tracking-[0.2em] hover:text-brand-primary transition-colors duration-300 mt-auto">
            INGRESAR 
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 transform transition-transform group-hover:translate-x-1"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" /></svg>
          </a>
        </div>

        <div class="flex flex-col items-center text-center group">
          
          <a href="/sports" class="w-56 h-56 md:w-64 md:h-64 mb-8 drop-shadow-[0_10px_20px_rgba(0,0,0,0.4)] transition-all duration-700 group-hover:scale-105 flex items-center justify-center relative block">
            <img src="/logo-sports.png" alt="MGEO Sports" class="w-64 h-64 md:w-72 md:h-72 object-contain scale-110" />
          </a>
          
          <p class="text-gray-300 text-sm md:text-base font-light max-w-xs md:max-w-sm mx-auto leading-relaxed mb-8">
            Representación estratégica, intermediación y Scouting de futbolistas.
          </p>
          
          <a href="/sports" class="inline-flex items-center gap-3 text-white font-body text-[10px] md:text-[11px] font-bold uppercase tracking-[0.2em] hover:text-brand-primary transition-colors duration-300 mt-auto">
            INGRESAR 
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 transform transition-transform group-hover:translate-x-1"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" /></svg>
          </a>
        </div>

      </div>
    </div>
  </section>  

</Layout>