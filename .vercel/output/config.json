{
	"version": 3,
	"routes": [
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^\\/_image\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/analisis\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/areas\\/art\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/areas\\/consumidor\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/areas\\/deportivo\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/areas\\/empresas\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/areas\\/laboral\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/areas\\/sucesiones\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/areas\\/transito\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/estudio\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/feedback\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/jugadores\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/sports\\/?$",
			"dest": "_render"
		},
		{
			"src": "^\\/$",
			"dest": "_render"
		}
	]
}