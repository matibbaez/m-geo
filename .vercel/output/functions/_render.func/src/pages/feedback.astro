---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Dejanos tu Reseña | M-GEO" 
  description="Valoramos tu opinión. Compartí tu experiencia trabajando con el equipo de M-GEO."
>
  
  <section class="relative min-h-screen flex items-center justify-center py-24 bg-brand-dark text-white overflow-hidden px-6">
    <!-- Efectos de fondo premium -->
    <div class="absolute inset-0 z-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]"></div>
    <div class="absolute top-0 right-0 w-[30rem] h-[30rem] bg-brand-primary/10 rounded-full blur-[100px] pointer-events-none z-0"></div>
    <div class="absolute bottom-0 left-0 w-[30rem] h-[30rem] bg-brand-primary/5 rounded-full blur-[100px] pointer-events-none z-0"></div>

    <div class="container mx-auto max-w-xl relative z-10 w-full mt-16 md:mt-0">
      
      <!-- CONTENEDOR DEL FORMULARIO (Se oculta si ya envió) -->
      <div id="form-container" class="transition-opacity duration-500 opacity-100">
        <!-- Encabezado -->
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-3 mb-4 justify-center">
            <span class="w-2 h-2 rounded-full bg-brand-primary animate-pulse"></span>
            <span class="text-gray-300 font-body text-[9px] uppercase tracking-widest font-bold">Feedback de Clientes</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-heading font-bold mb-4 tracking-tighter">Tu <span class="italic font-light text-gray-400">experiencia</span>.</h1>
          <p class="text-gray-400 font-light text-sm md:text-base px-4">Tu opinión es fundamental para seguir elevando nuestro estándar de excelencia institucional y deportiva.</p>
        </div>

        <!-- Formulario -->
        <form id="form-feedback" class="bg-[#111] border border-white/5 p-8 md:p-10 rounded-sm flex flex-col gap-6 shadow-2xl backdrop-blur-sm relative">
          
          <div>
            <label for="nombre" class="block text-[10px] uppercase tracking-[0.2em] font-body text-gray-400 mb-2 font-semibold">Tu Nombre o Institución</label>
            <input type="text" id="nombre" name="nombre" required 
              class="w-full bg-brand-dark border border-white/10 text-white px-5 py-4 outline-none focus:border-brand-primary transition-colors duration-300 text-sm font-light" 
              placeholder="Ej: Juan Pérez / Club Atlético X" />
          </div>

          <div>
            <label class="block text-[10px] uppercase tracking-[0.2em] font-body text-gray-400 mb-2 font-semibold">Calificación del Servicio</label>
            <div class="flex gap-3" id="star-rating">
              <svg class="w-8 h-8 text-brand-primary cursor-pointer hover:scale-110 transition-all duration-300 star-icon drop-shadow-lg" data-value="1" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg class="w-8 h-8 text-brand-primary cursor-pointer hover:scale-110 transition-all duration-300 star-icon drop-shadow-lg" data-value="2" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg class="w-8 h-8 text-brand-primary cursor-pointer hover:scale-110 transition-all duration-300 star-icon drop-shadow-lg" data-value="3" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg class="w-8 h-8 text-brand-primary cursor-pointer hover:scale-110 transition-all duration-300 star-icon drop-shadow-lg" data-value="4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              <svg class="w-8 h-8 text-brand-primary cursor-pointer hover:scale-110 transition-all duration-300 star-icon drop-shadow-lg" data-value="5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            </div>
            <input type="hidden" name="rating" id="rating-value" value="5" required>
          </div>

          <div>
            <label for="comentario" class="block text-[10px] uppercase tracking-[0.2em] font-body text-gray-400 mb-2 font-semibold">Tu Reseña</label>
            <textarea id="comentario" name="comentario" rows="5" required 
              class="w-full bg-brand-dark border border-white/10 text-white px-5 py-4 outline-none focus:border-brand-primary transition-colors duration-300 text-sm font-light resize-none" 
              placeholder="Compartí brevemente tu experiencia con la agencia o el estudio jurídico..."></textarea>
          </div>

          <button type="submit" id="btn-submit" class="bg-brand-primary text-white font-body font-bold uppercase tracking-[0.2em] text-[11px] py-5 hover:bg-white hover:text-brand-dark transition-all duration-500 mt-2 shadow-[0_10px_30px_-10px_rgba(120,22,22,0.5)] flex justify-center items-center gap-3 group">
            <span>Enviar Reseña Institucional</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </button>

        </form>
      </div>

      <!-- CONTENEDOR DE ÉXITO (Se muestra si ya envió la reseña) -->
      <div id="success-container" class="hidden opacity-0 transition-opacity duration-700 bg-[#111] border border-white/5 p-10 md:p-16 rounded-sm shadow-2xl backdrop-blur-sm text-center flex flex-col items-center justify-center">
        <div class="w-20 h-20 rounded-full bg-brand-primary/10 border border-brand-primary/20 flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-brand-primary">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <h3 class="text-3xl md:text-4xl font-heading font-bold text-white tracking-tight mb-4">Reseña Recibida</h3>
        <p class="text-gray-400 font-light text-base md:text-lg leading-relaxed max-w-sm mx-auto mb-10">
          Gracias por tomarte el tiempo de compartir tu experiencia. Tu testimonio ya fue registrado en nuestro sistema.
        </p>
        <a href="/" class="border border-white/20 text-white font-body font-bold uppercase tracking-[0.2em] text-[10px] px-10 py-4 hover:bg-white hover:text-brand-dark transition-all duration-300">
          Volver al inicio
        </a>
      </div>

    </div>
  </section>

  <!-- Notificación Flotante (Toast) -->
  <div id="toast-notification" class="fixed bottom-8 right-8 translate-y-20 opacity-0 pointer-events-none transition-all duration-500 z-50 flex items-center gap-4 bg-[#111] border border-brand-primary/30 text-white px-6 py-4 rounded-sm shadow-[0_10px_40px_-10px_rgba(120,22,22,0.6)]">
    <div class="bg-brand-primary/20 p-2 rounded-full">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-brand-primary">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>
    <div>
      <h5 class="font-heading font-bold text-sm text-white">Reseña enviada</h5>
      <p id="toast-message" class="font-light text-xs text-gray-400 mt-0.5">Gracias por tu tiempo.</p>
    </div>
  </div>

</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const supabase = createClient(supabaseUrl, supabaseKey);

  document.addEventListener('DOMContentLoaded', () => {
    const stars = document.querySelectorAll('.star-icon');
    const ratingInput = document.getElementById('rating-value') as HTMLInputElement;
    const form = document.getElementById('form-feedback') as HTMLFormElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
    
    const toast = document.getElementById('toast-notification');
    const toastMessage = document.getElementById('toast-message');

    const formContainer = document.getElementById('form-container');
    const successContainer = document.getElementById('success-container');

    // 1. VERIFICAR SI YA ENVIÓ UNA RESEÑA PREVIAMENTE
    const hasReviewed = localStorage.getItem('mgeo_review_submitted');
    
    if (hasReviewed === 'true' && formContainer && successContainer) {
      // Ocultar formulario y mostrar tarjeta de éxito directamente
      formContainer.classList.add('hidden');
      successContainer.classList.remove('hidden');
      setTimeout(() => {
        successContainer.classList.remove('opacity-0');
      }, 50);
    }

    const mostrarToast = (mensaje: string) => {
      if (!toast || !toastMessage) return;
      
      toastMessage.textContent = mensaje;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 4000);
    };

    stars.forEach(star => {
      star.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const value = parseInt(target.getAttribute('data-value') || '5');
        
        if(ratingInput) ratingInput.value = value.toString();
        
        stars.forEach(s => {
          const starValue = parseInt(s.getAttribute('data-value') || '0');
          if (starValue <= value) {
            s.classList.remove('text-gray-600');
            s.classList.add('text-brand-primary');
          } else {
            s.classList.remove('text-brand-primary');
            s.classList.add('text-gray-600');
          }
        });
      });
    });

    if(form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault(); 
        
        const originalText = btnSubmit.innerHTML;
        btnSubmit.innerHTML = '<span class="animate-pulse">Enviando...</span>';
        btnSubmit.disabled = true;
        
        const formData = new FormData(form);
        const data = Object.fromEntries(formData);
        
        const { error } = await supabase
          .from('resenas')
          .insert([
            { 
              nombre: data.nombre, 
              texto: data.comentario, 
              estrellas: parseInt(data.rating as string),
              unidad: 'M-GEO', 
              publicada: true 
            }
          ]);

        if (error) {
          console.error('Error al guardar:', error);
          mostrarToast('Hubo un error. Intentá nuevamente.');
          btnSubmit.innerHTML = originalText;
          btnSubmit.disabled = false;
        } else {
          mostrarToast(`¡Gracias ${data.nombre}! Tu reseña fue recibida.`);
          
          // Guardar en localStorage para bloquear futuros envíos
          localStorage.setItem('mgeo_review_submitted', 'true');

          // Transición suave: Ocultar form, mostrar success
          if(formContainer && successContainer) {
            formContainer.classList.add('opacity-0');
            setTimeout(() => {
              formContainer.classList.add('hidden');
              successContainer.classList.remove('hidden');
              setTimeout(() => {
                successContainer.classList.remove('opacity-0');
              }, 50);
            }, 500); // Espera medio segundo a que termine el fade-out del form
          }
        }
      });
    }
  });
</script>